{
  "name": "yt-director-workbench-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "npm run build:api && node scripts/dev-api.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.frontend.json && tsc -p tsconfig.backend.json",
    "lint": "node scripts/check-boundaries.mjs",
    "build": "vite build",
    "build:api": "wrangler deploy --dry-run --outdir dist/worker",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run build:api && npm run test:runtime",
    "dev:api:wrangler": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "test:runtime": "node --test test/runtime.test.mjs",
    "test:browser": "node scripts/qa-browser.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261009.1",
    "@playwright/test": "1.64.0",
    "happy-dom": "20.14.6",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  }
}
